# =======  Dataset Configuration  =======
# Template according to #1613
# The first model in this block can be overridden
# in the command line by using:
# --model, --exp, --source, --outputdir, --catalog

# Datasets holds the models, adding more than one "-"
# will create a list of dict
datasets:
  - catalog: null              # mandatory as null
    model: 'IFS-NEMO'          # mandatory
    exp: 'historical-1990'     # mandatory
    source: 'lra-r100-monthly' # mandatory
    regrid: null               # if the diagnostic supports it
    reader_kwargs: null        # it can be a dictionary with reader kwargs
    startdate: null            # e.g. '1990-01-01'
    enddate: null              # e.g. '2000-12-31'

# =======  Reference Datasets  =======
# Each reference covers one hemisphere and is used for the regions of that hemisphere:
#   domain:  'nh' or 'sh' (all the regions if missing)
#   methods: the sea ice methods it is used for (all the methods of a tool if missing)
references:
  # ---- Sea ice thickness in NH ----
  - catalog: 'obs'
    model: 'PSC'
    exp: 'PIOMAS'
    source: 'monthly'
    regrid: 'r100'
    domain: 'nh'
    startdate: '{{ default.startdate }}'
    enddate: '{{ default.enddate }}'

  # ---- Sea ice thickness in SH ----
  - catalog: 'obs'
    model: 'PSC'
    exp: 'GIOMAS'
    source: 'monthly'
    regrid: 'r100'
    domain: 'sh'
    startdate: '{{ default.startdate }}'
    enddate: '{{ default.enddate }}'

# =======  Setup Configuration  =======
setup:
  loglevel: 'WARNING'

# =======  Output Configuration  =======
output:
  outputdir: "./" # mandatory
  rebuild: true
  save_netcdf: true # mandatory
  save_format: ['png', 'pdf', 'svg']
  dpi: 300

# =======  Diagnostics Configuration  =======
# methods: sea ice methods to compute; the variable of a method can be changed with params.<method>.var
# params.default: regions (names from config/definitions/regions.yaml) and options of the computation
diagnostics:
  # =======  Config for timeseries Sea Ice  =======
  # ===============================================
  seaice_timeseries:
    run: true
    diagnostic_name: 'seaice'
    methods: ['volume']
    params:
      default:
        regions: ['arctic', 'antarctic']
        std: true      # +/- 2 std band around the references, by calendar month
        annual: false  # also plot the annual means (complete years only)
        # the references use the timeseries-specific window (climatedt-experiment-kind.yaml)
        ref_startdate: '{{ timeseries.startdate }}'
        ref_enddate: '{{ timeseries.enddate }}'

  # =======  Config for seasonal cycle Sea Ice  =======
  # ===================================================
  seaice_seasonal_cycle:
    run: true
    diagnostic_name: 'seaice'
    methods: ['volume']
    params:
      default:
        regions: ['arctic', 'antarctic']
        std: true      # +/- 2 std band around the references, by calendar month

  # =======  Config for 2d bias maps =======
  # =========================================
  seaice_2d_bias:
    run: true
    diagnostic_name: 'seaice'
    methods: ['thickness']
    params:
      default:
        regions: ['arctic', 'antarctic']
    plot_params:
      default:
        # List of months to plot (e.g., [3, 9] for March and September)
        months: [3, 9]
