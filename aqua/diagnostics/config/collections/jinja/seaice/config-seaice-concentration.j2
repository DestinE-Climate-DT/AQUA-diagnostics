# =======  Dataset Configuration  =======
# Template according to #1613
# The first model in this block can be overridden
# in the command line by using:
# --model, --exp, --source, --outputdir, --catalog

# Datasets holds the models, adding more than one "-"
# will create a list of dict
datasets:
  - catalog: null              # mandatory as null
    model: 'IFS-NEMO'          # mandatory
    exp: 'historical-1990'     # mandatory
    source: 'lra-r100-monthly' # mandatory
    regrid: null               # if the diagnostic supports it
    reader_kwargs: null        # it can be a dictionary with reader kwargs
    startdate: null            # e.g. '1990-01-01'
    enddate: null              # e.g. '2000-12-31'

# =======  Reference Datasets  =======
references:
  # ---- Extent in NH ----
  - &ref_osi_nh
    catalog: '{{ references.seaice_concentration_nh.catalog }}'  # mandatory
    model: '{{ references.seaice_concentration_nh.model }}'  # mandatory
    exp: '{{ references.seaice_concentration_nh.exp }}'  # mandatory
    source: '{{ references.seaice_concentration_nh.source }}'  # mandatory
    regrid: '{{ regrid }}'
    domain: "nh"
    startdate: '{{ period.default.startdate }}'
    enddate: '{{ period.default.enddate }}'

  # ---- Extent in SH ----
  - &ref_osi_sh
    catalog: '{{ references.seaice_concentration_sh.catalog }}'  # mandatory
    model: '{{ references.seaice_concentration_sh.model }}'  # mandatory
    exp: '{{ references.seaice_concentration_sh.exp }}'  # mandatory
    source: '{{ references.seaice_concentration_sh.source }}'  # mandatory
    regrid: '{{ regrid }}'
    domain: "sh"
    startdate: '{{ period.default.startdate }}'
    enddate: '{{ period.default.enddate }}'

# =======  Setup Configuration  =======
setup:
  loglevel: '{{ loglevel }}'

# =======  Output Configuration  =======
output:
  outputdir: "./" # mandatory
  rebuild: {{ output.rebuild }}
  save_netcdf: true # mandatory
  save_format: {{ output.save_format }}
  dpi: {{ output.dpi }}

# =======  Diagnostics Configuration  =======
diagnostics:
  # =======  Config for timeseries Sea Ice  =======
  # ===============================================
  seaice_timeseries:
    run: true
    # List of methods to plot.
    methods: ["extent"]
    # List of regions to plot. The default regions are defined in config/diagnostics/seaice
    regions: ['arctic','antarctic']
    calc_ref_std: true
    ref_std_freq: 'monthly' # set to 'monthly' 'annual'
    varname:
      extent: 'siconc'

    # ====  Update Datasets and reference entries  ====
    # timeseries uses the timeseries-specific window (climatedt-experiment-kind.yaml),
    # overriding the anchor's default window
    references:
    # -- OSI-SAF for "extent" in NH --
    - <<: *ref_osi_nh
      use_for_method: "extent"
      startdate: '{{ period.timeseries.startdate }}'
      enddate: '{{ period.timeseries.enddate }}'

    # -- OSI-SAF for "extent" in SH --
    - <<: *ref_osi_sh
      use_for_method: "extent"
      startdate: '{{ period.timeseries.startdate }}'
      enddate: '{{ period.timeseries.enddate }}'

  # =======  Config for seasonal cycle Sea Ice  =======
  # ===================================================
  seaice_seasonal_cycle:
    run: true
    methods: ["extent"]
    regions: ['arctic','antarctic']
    calc_ref_std: true
    ref_std_freq: 'monthly' # set to 'monthly' 'annual'
    varname:
      extent: 'siconc'

    # ====  Update Datasets and reference entries  ====
    references:
    # -- OSI-SAF for "extent" in NH --
    - <<: *ref_osi_nh
      use_for_method: "extent"

    # -- OSI-SAF for "extent" in SH --
    - <<: *ref_osi_sh
      use_for_method: "extent"

  # =======  Config for 2d bias maps =======
  # =========================================
  seaice_2d_bias:
    run: true
    methods: ["fraction"]
    regions: ['arctic','antarctic']
    # List of months to plot (e.g., [3, 9] for March and September)
    months: [3, 9]
    # List of projections to use
    projections:
      orthographic:
        projname: "orthographic"
        projpars:
          central_longitude: 0.0
          central_latitude: "max_lat_signed"
      azimuthal_equidistant:
        projname: "azimuthal_equidistant"
        projpars:
          central_longitude: 0.0
          central_latitude: "max_lat_signed"
        extent_regions:
          Arctic: [-180, 180, 50, 90]
          Antarctic: [-180, 180, -50, -90]
    varname:
      fraction: 'siconc'

    # ====  Update Datasets and reference entries  ====
    references:
    # -- OSI-SAF for fraction in NH --
    - <<: *ref_osi_nh
      use_for_method: "fraction"

    # -- OSI-SAF for fraction in SH --
    - <<: *ref_osi_sh
      use_for_method: "fraction"
