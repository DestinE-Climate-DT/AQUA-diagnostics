# Currently, the diagnostic supports comparing one dataset against one reference dataset at a time.
datasets:
  - catalog: null
    model: null
    exp: null
    source: null
    regrid: null
    reader_kwargs: null # it can be a dictionary with reader kwargs
    startdate: null
    enddate: null

references:
  - catalog: '{{ references.atmosphere3d_plev.catalog }}'
    model: '{{ references.atmosphere3d_plev.model }}'
    exp: '{{ references.atmosphere3d_plev.exp }}'
    source: '{{ references.atmosphere3d_plev.source }}'
    regrid: '{{ regrid }}'
    startdate: '{{ period.default.startdate }}'
    enddate: '{{ period.default.enddate }}'

setup:
  loglevel: '{{ loglevel }}'

output:
  outputdir: "./"
  rebuild: {{ output.rebuild }}
  save_netcdf: true
  save_format: {{ output.save_format }}
  dpi: {{ output.dpi }}

diagnostics:
  biases:
    run: true
    diagnostic_name: 'atmosphere3d'
    variables: ['t', 'u', 'v', 'q']
    params:
      default:
        plev: [85000, 25000] # Level plot for 2D bias map if variable 3d
        seasons: true
        seasons_stat: 'mean' # May become a list
        vertical: true     # Vertical profile if variable 3d
    plot_params:
      default:
        projection: 'robinson'
        projection_params: {}
        cmap: 'PuOr_r'
        show_stats: true
        show_significance: true    # Enable significance stippling
        significance_alpha: 0.05  # 95% confidence level
      t:
        vmin: -8
        vmax: 8
        vmin_v: -12
        vmax_v: 12
        cmap: 'RdBu_r'
      u:
        vmin: -10
        vmax: 10
        vmin_v: -12
        vmax_v: 12
      v:
        vmin: -3
        vmax: 3
        vmin_v: -1
        vmax_v: 1
      #q:
      #  vmin: -0.002
      #  vmax: 0.002
      #  vmin_v: -0.002
      #  vmax_v: 0.002
      #  cmap: 'BrBG'
