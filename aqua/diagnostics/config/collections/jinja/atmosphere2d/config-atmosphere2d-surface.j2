# Currently, the diagnostic supports comparing one dataset against one reference dataset at a time.
datasets:
  - catalog: null
    model: null
    exp: null
    source: null
    regrid: null
    reader_kwargs: null # it can be a dictionary with reader kwargs
    startdate: null
    enddate: null

references:
  - catalog: '{{ references.atmosphere2d_surface.catalog }}'
    model: '{{ references.atmosphere2d_surface.model }}'
    exp: '{{ references.atmosphere2d_surface.exp }}'
    source: '{{ references.atmosphere2d_surface.source }}'
    regrid: '{{ regrid }}'
    startdate: '{{ period.default.startdate }}'
    enddate: '{{ period.default.enddate }}'

setup:
  loglevel: '{{ loglevel }}'

output:
  outputdir: "./"
  rebuild: {{ output.rebuild }}
  save_netcdf: true
  save_format: {{ output.save_format }}
  dpi: {{ output.dpi }}

diagnostics:
  biases:
    run: true
    diagnostic_name: 'atmosphere2d'
    variables: ['msl']
    formulae: ['(10u^2+10v^2)^0.5']
    params:
      default:
        seasons: true
        seasons_stat: 'mean' # May become a list
        vertical: false     # Vertical profile if variable 3d
      (10u^2+10v^2)^0.5:
        short_name: "10si"
        long_name: "Wind speed at 10m"
    plot_params:
      default:
        projection: 'robinson'
        projection_params: {}
        show_stats: true
        show_significance: true    # Enable significance stippling
        significance_alpha: 0.05  # 95% confidence level
      msl:
        vmin: -1000
        vmax: 1000
        cmap: 'RdBu_r'
      (10u^2+10v^2)^0.5:
        vmin: -2.5
        vmax: 2.5
        cmap: 'RdBu_r'

  seasonalcycles:
    run: true
    diagnostic_name: 'atmosphere2d'
    variables: ['ie', 'msl', 'tcc']
    center_time: true
    params:
      default:
        std_startdate: '{{ period.default.std_startdate }}'
        std_enddate: '{{ period.default.std_enddate }}'

  timeseries:
    run: true
    diagnostic_name: 'atmosphere2d'
    variables: ['ie', 'msl', 'tcc']
    center_time: true
    params:
      default:
        hourly: False
        daily: False
        monthly: True
        annual: True
        std_startdate: '{{ period.timeseries.std_startdate }}'
        std_enddate: '{{ period.timeseries.std_enddate }}'
