# Model-only trend maps. The analysis wrapper supplies the dataset and analysis dates.
datasets:
  - catalog: null
    model: null
    exp: null
    source: null
    regrid: null
    reader_kwargs: {chunks: {"time": 12}}
    startdate: null
    enddate: null

setup:
  loglevel: 'WARNING'

output:
  outputdir: "./"
  rebuild: true
  save_netcdf: true
  save_format: ['png', 'pdf', 'svg']
  dpi: 300

diagnostics:
  trends:
    run: true
    diagnostic_name: 'atmosphere2d'
    var: ['2t', 'msl']
