# Currently, the diagnostic supports comparing one dataset against one reference dataset at a time.
datasets:
  - catalog: null
    model: null
    exp: null
    source: 'lra-r100-monthly'
    regrid: null
    reader_kwargs: null # it can be a dictionary with reader kwargs
    startdate: null
    enddate: null
  # Possible second/third/fourth datasets here, no present by default
  # - catalog: 'obs'
  #   model: 'ECMWF'
  #   exp: 'era5'
  #   source: 'monthly'
  #   regrid: r100

references:
  - catalog: '{{ references.atmosphere2d_temperature.catalog }}'
    model: '{{ references.atmosphere2d_temperature.model }}'
    exp: '{{ references.atmosphere2d_temperature.exp }}'
    source: '{{ references.atmosphere2d_temperature.source }}'
    regrid: '{{ regrid }}'
    startdate: '{{ period.default.startdate }}'
    enddate: '{{ period.default.enddate }}'

setup:
  loglevel: '{{ loglevel }}'

output:
  outputdir: "./"
  rebuild: {{ output.rebuild }}
  save_netcdf: true
  save_format: {{ output.save_format }}
  dpi: {{ output.dpi }}

diagnostics:
  biases:
    run: true
    diagnostic_name: 'atmosphere2d'
    variables: ['2t']
    params:
      default:
        seasons: true
        seasons_stat: 'mean' # May become a list
        vertical: false     # Vertical profile if variable 3d
    plot_params:
      default:
        projection: 'robinson'
        projection_params: {}
        show_stats: true
        show_significance: true    # Enable significance stippling
        significance_alpha: 0.05  # 95% confidence level
      2t:
        vmin: -7
        vmax: 7
        cmap: 'RdBu_r'

  timeseries:
    run: true
    diagnostic_name: 'atmosphere2d'
    variables: ['2t']
    center_time: true
    extend: false
    params:
      default:
        hourly: False
        daily: False
        monthly: True
        annual: True
        std_startdate: '{{ period.timeseries.std_startdate }}'
        std_enddate: '{{ period.timeseries.std_enddate }}'
      2t:
        regions: ['nh', 'sh', 'europe']

  seasonalcycles:
    run: true
    diagnostic_name: 'atmosphere2d'
    variables: ['2t']
    center_time: true
    params:
      default:
        std_startdate: '{{ period.default.std_startdate }}'
        std_enddate: '{{ period.default.std_enddate }}'
      2t:
        regions: ['nh', 'sh', 'europe']

  lat_lon_profiles:
    run: true
    diagnostic_name: 'atmosphere2d'
    mean_type: 'zonal'
    center_time: true
    exclude_incomplete: true
    box_brd: true
    seasonal: true
    longterm: true
    params:
      default:
        std_startdate: '{{ period.default.std_startdate }}'
        std_enddate: '{{ period.default.std_enddate }}'
    variables:
      - name: '2t'
        regions: [null, 'tropics']  # global and tropics
