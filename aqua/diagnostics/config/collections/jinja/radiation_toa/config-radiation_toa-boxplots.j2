# Template according to #1613
# The first model in this block can be overridden
# in the command line by using:
# --model, --exp, --source, --outputdir, --catalog
datasets:
  - catalog: null
    model: null
    exp: null
    source: 'lra-r100-monthly'
    regrid: null
    reader_kwargs: null # it can be a dictionary with reader kwargs
    startdate: null
    enddate: null
  # Possible second/third/fourth datasets here, no present by default
  # - catalog: 'obs'
  #   model: 'ECMWF'
  #   exp: 'era5'
  #   source: 'monthly'
  #   regrid: r100

references:
  - catalog: '{{ references.atmosphere.catalog }}'
    model: '{{ references.atmosphere.model }}'
    exp: '{{ references.atmosphere.exp }}'
    regrid: 'r100'
    source: '{{ references.atmosphere.source }}'
    startdate: '{{ reference.startdate }}'
    enddate: '{{ reference.enddate }}'
  - catalog: '{{ references.radiation_toa.catalog }}'
    model: '{{ references.radiation_toa.model }}'
    exp: '{{ references.radiation_toa.exp }}'
    source: '{{ references.radiation_toa.source }}'
    regrid: 'r100'
    reader_kwargs: null
    startdate: '{{ radiation.startdate }}'
    enddate: '{{ radiation.enddate }}'

output:
  outputdir: "./"
  rebuild: true
  save_format: ['png', 'pdf', 'svg']
  dpi: 300

diagnostics:
  boxplots:
    run: true
    diagnostic_name: 'radiation_toa'
    variables:
      - vars: ['-tnlwrf', 'tnswrf']
        add_mean_line: true
        anomalies: true
        ref_number: 0 # use ERA5 as reference for anomalies
