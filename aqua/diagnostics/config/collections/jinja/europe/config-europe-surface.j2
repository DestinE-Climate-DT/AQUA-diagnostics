# Timeseries of the European mean (land and sea) of surface fields.
# 10m wind speed (10si: bias map and timeseries) to be added when the LRA provides it (o27.1, AQUA#2891).
datasets:
  - catalog: null
    model: null
    exp: null
    source: 'lra-r100-monthly'
    regrid: null
    reader_kwargs: null # it can be a dictionary with reader kwargs
    startdate: null
    enddate: null

references:
  - catalog: '{{ references.europe_surface.catalog }}'
    model: '{{ references.europe_surface.model }}'
    exp: '{{ references.europe_surface.exp }}'
    source: '{{ references.europe_surface.source }}'
    regrid: '{{ regrid }}'
    startdate: '{{ period.standard.startdate }}'
    enddate: '{{ period.standard.enddate }}'

setup:
  loglevel: '{{ loglevel }}'

output:
  outputdir: "./"
  rebuild: {{ output.rebuild }}
  save_netcdf: {{ output.save_netcdf }}
  save_format: {{ output.save_format }}
  dpi: {{ output.dpi }}

diagnostics:
  timeseries:
    run: true
    diagnostic_name: 'europe'
    variables: ['2t', 'tprate']
    center_time: true
    include_global: false  # only the regions below
    params:
      default:
        hourly: False
        daily: False
        monthly: True
        annual: True
        std_startdate: '{{ period.timeseries.std_startdate }}'
        std_enddate: '{{ period.timeseries.std_enddate }}'
        regions: ['europe']
      tprate:
        units: 'mm/day'
