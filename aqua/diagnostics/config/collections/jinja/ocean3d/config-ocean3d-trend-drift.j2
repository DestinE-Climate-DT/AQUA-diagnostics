# Template according to #1613
# The first model in this block can be overridden
# in the command line by using:
# --model, --exp, --source, --outputdir, --catalog
datasets:
  - catalog: null
    model: FESOM
    exp: hpz3
    source: monthly-3d
    regrid: null
    reader_kwargs: {chunks: {"time": 12}}  # recommended for DE
    # startdate: 1990-01
    # enddate: 1990-12

output:
  outputdir: "./"
  rebuild: {{ output.rebuild }}
  save_netcdf: true
  plot_only: false  # if true, plots are produced from the netcdf files already in outputdir
  save_format: {{ output.save_format }}
  dpi: {{ output.dpi }}

diagnostics:
  ocean_drift:
    hovmoller:
      vert_coord: depth
      diagnostic_name: 'ocean3d'
      run: true
      var: ['thetao', 'so']
      regions: ['go', 'io', 'ao', 'so', 'arc_o', 'po']
      dim_mean: ['lat', 'lon']

  ocean_trends:
    multilevel:
      diagnostic_name: 'ocean3d'
      vert_coord: depth
      run: true
      var: ['thetao', 'so']
      regions: ['go']
    zonal:
      diagnostic_name: 'ocean3d'
      vert_coord: depth
      run: true
      var: ['thetao', 'so']
      regions: ['go', 'io', 'ao', 'so', 'arc_o', 'po']
