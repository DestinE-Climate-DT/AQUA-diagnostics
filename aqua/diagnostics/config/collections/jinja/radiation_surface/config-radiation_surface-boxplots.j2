# Template according to #1613
# The first model in this block can be overridden
# in the command line by using:
# --model, --exp, --source, --outputdir, --catalog
datasets:
  - catalog: null
    model: IFS-NEMO
    exp: ssp370
    source: 'lra-r100-monthly'
    regrid: null
    reader_kwargs: null # it can be a dictionary with reader kwargs
    startdate: null
    enddate: null
  # Possible second/third/fourth datasets here, no present by default
  # - catalog: 'obs'
  #   model: 'ECMWF'
  #   exp: 'era5'
  #   source: 'monthly'
  #   regrid: r100

references:
  - catalog: {{ references.era5.catalog | tojson }}
    model: {{ references.era5.model | tojson }}
    exp: {{ references.era5.exp | tojson }}
    source: {{ references.era5.source | tojson }}
    startdate: '{{ default.startdate }}'
    enddate: '{{ default.enddate }}'
  - catalog: {{ references.ceres_sfc.catalog | tojson }}
    model: {{ references.ceres_sfc.model | tojson }}
    exp: {{ references.ceres_sfc.exp | tojson }}
    source: {{ references.ceres_sfc.source | tojson }}
    regrid: 'r100'
    reader_kwargs: null
    startdate: '{{ radiation_ceres.startdate }}'
    enddate: '{{ radiation_ceres.enddate }}'

output:
  outputdir: "./"
  rebuild: true
  save_format: ['png', 'pdf', 'svg']
  dpi: 300

diagnostics:
  boxplots:
    run: true
    diagnostic_name: 'radiation_surface'
    variables:
      - vars: ['-snlwrf', 'snswrf', 'slhtf', 'ishf']
        anomalies: true
        add_mean_line: true
        ref_number: 0 # use ERA5 as reference for anomalies
